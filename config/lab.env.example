# Optional overrides. By default the scripts discover the cluster apps domain.
CALLER_NAMESPACE=caller-ns
CALLING_NAMESPACE=calling-ns
CERT_MANAGER_NAMESPACE=cert-manager
CLUSTER_ISSUER_NAME=external-intermediate-ca
CALLER_APP_NAME=caller-app
CALLING_APP_NAME=calling-app
# cert-manager minimums are 60m duration and 5m renewBefore. These short
# values make rotation observable in this lab; use longer values in production.
CERTIFICATE_DURATION=60m
CERTIFICATE_RENEW_BEFORE=10m
ROOT_CA_COMMON_NAME="Acme Root CA"
INTERMEDIATE_CA_COMMON_NAME="Acme Intermediate CA"
# Route creation and Route certificate SANs are independent controls.
CREATE_ROUTES=true
INCLUDE_ROUTE_SANS=true
# An explicit domain wins over discovery. A leading "*." is normalized.
APPS_DOMAIN=
# Discovery is used only when APPS_DOMAIN is empty. The fallback keeps local
# render/validation independent of a cluster connection.
AUTO_DISCOVER_APPS_DOMAIN=true
APPS_DOMAIN_FALLBACK=apps.example.test
