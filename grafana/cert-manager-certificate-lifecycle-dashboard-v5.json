          "editorMode": "code",
          "expr": "count((certmanager_certificate_not_after_timestamp_seconds{job=\"cert-manager\", exported_namespace=~\"$namespace\", issuer_name=~\"$issuer\"} - time() < 604800) and (certmanager_certificate_not_after_timestamp_seconds{job=\"cert-manager\", exported_namespace=~\"$namespace\", issuer_name=~\"$issuer\"} > time()))",
          "format": "time_series",
          "instant": true,
          "legendFormat": "",
          "refId": "A",
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
