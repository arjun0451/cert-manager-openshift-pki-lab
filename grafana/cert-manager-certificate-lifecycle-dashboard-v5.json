      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Certificate expiry — days remaining",
      "description": "Days until certificate expiry. Negative values indicate expired certificates.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(certmanager_certificate_not_after_timestamp_seconds{job=\"cert-manager\", exported_namespace=~\"$namespace\", issuer_name=~\"$issuer\"} - time()) / 86400",
          "format": "table",
          "instant": true,
          "legendFormat": "{{exported_namespace}} / {{name}}",
          "refId": "A",
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "pod": true,
              "prometheus": true,
              "service": true,
              "issuer_group": true,
              "issuer_kind": true,
              "namespace": true
            },
            "indexByName": {},
            "renameByName": {
              "exported_namespace": "Certificate namespace",
              "name": "Certificate",
              "issuer_name": "Issuer",
              "Value": "Days remaining"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false
        }
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Certificate renewal — days until scheduled renewal",
      "description": "Days until the renewal timestamp currently exported by cert-manager.",
      "gridPos": {
