            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "count((max by (exported_namespace, name, issuer_name) (certmanager_certificate_ready_status{job=\"cert-manager\", condition=\"True\", exported_namespace=~\"$namespace\", issuer_name=~\"$issuer\"} == 1)) and on (exported_namespace, name, issuer_name) (certmanager_certificate_not_before_timestamp_seconds{job=\"cert-manager\", exported_namespace=~\"$namespace\", issuer_name=~\"$issuer\"} <= time()) and on (exported_namespace, name, issuer_name) (certmanager_certificate_not_after_timestamp_seconds{job=\"cert-manager\", exported_namespace=~\"$namespace\", issuer_name=~\"$issuer\"} > time()))",
          "format": "time_series",
          "instant": true,
          "legendFormat": "",
          "refId": "A",
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
