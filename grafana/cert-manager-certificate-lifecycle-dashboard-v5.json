    {
      "id": 12,
      "type": "timeseries",
      "title": "Controller sync errors (rate over time)",
      "description": "Per-second rate of controller sync errors. A flat zero line is expected when reconciliation is healthy.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (controller) (rate(certmanager_controller_sync_error_count{job=\"cert-manager\"}[5m]))",
          "format": "time_series",
          "instant": false,
          "legendFormat": "{{controller}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 14,
      "type": "table",
      "title": "Certificate validity and expiry",
      "description": "One row per certificate. Joined using a stable key composed of certificate namespace, name and issuer. Red indicates one day or less remaining, including expired certificates.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "label_join(certmanager_certificate_not_before_timestamp_seconds{job=\"cert-manager\", exported_namespace=~\"$namespace\", issuer_name=~\"$issuer\"} * 1000, \"certificate_key\", \"/\", \"exported_namespace\", \"name\", \"issuer_name\")",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A",
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "label_join(certmanager_certificate_not_after_timestamp_seconds{job=\"cert-manager\", exported_namespace=~\"$namespace\", issuer_name=~\"$issuer\"} * 1000, \"certificate_key\", \"/\", \"exported_namespace\", \"name\", \"issuer_name\")",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "B",
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "label_join((certmanager_certificate_not_after_timestamp_seconds{job=\"cert-manager\", exported_namespace=~\"$namespace\", issuer_name=~\"$issuer\"} - time()) / 86400, \"certificate_key\", \"/\", \"exported_namespace\", \"name\", \"issuer_name\")",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "C",
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "certificate_key",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "pod": true,
              "prometheus": true,
              "service": true,
              "namespace": true,
              "issuer_group": true,
              "certificate_key": true
            },
            "indexByName": {
              "exported_namespace": 0,
              "name": 1,
              "issuer_name": 2,
              "issuer_kind": 3,
              "Value #A": 4,
              "Value #B": 5,
              "Value #C": 6
            },
            "renameByName": {
              "exported_namespace": "Namespace",
              "name": "Certificate",
              "issuer_name": "Issuer",
              "issuer_kind": "Issuer type",
              "Value #A": "Not Before",
              "Value #B": "Not After",
              "Value #C": "Days remaining"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Not Before"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Not After"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
